{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/operator-public-corpus.schema.json",
  "title": "Hyperion Operator Public Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "revision", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "revision": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sourcePath", "visibility", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sourcePath": { "type": "string", "pattern": "^/[a-z0-9/_-]*$" },
          "visibility": { "const": "public" },
          "content": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    }
  }
}
