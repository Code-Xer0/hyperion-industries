{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hyperion-industries.dev/intake/intake-submission.v1.json",
  "title": "Hyperion Intake Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_id", "session_id", "submission_id", "revision", "form_id",
    "form_version", "submitted_at", "answers", "artifacts", "consents",
    "client_reviewed", "trace_id"
  ],
  "properties": {
    "intake_id": { "type": "string", "pattern": "^int_[A-Za-z0-9_-]{12,64}$" },
    "session_id": { "type": "string", "pattern": "^ses_[A-Za-z0-9_-]{12,64}$" },
    "submission_id": { "type": "string", "pattern": "^sub_[A-Za-z0-9_-]{12,64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes_submission_id": { "type": ["string", "null"] },
    "form_id": {
      "type": "string",
      "enum": ["universal-router", "forge-build-profile", "forge-configurator", "pandora-readiness", "continuity-assessment", "operator-identity", "support", "relationship", "general"]
    },
    "form_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locale": { "type": "string", "default": "en-US" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 16, "maxLength": 64 },
    "client_reviewed": { "const": true },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact_name": { "type": ["string", "null"], "maxLength": 200 },
        "email": { "type": ["string", "null"], "format": "email", "maxLength": 320 },
        "phone": { "type": ["string", "null"], "maxLength": 40 },
        "organization": { "type": ["string", "null"], "maxLength": 240 },
        "organization_domain": { "type": ["string", "null"], "maxLength": 253 },
        "existing_client_reference": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/answer" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "consents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consent" }
    },
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_url": { "type": ["string", "null"], "format": "uri" },
        "referrer_category": { "type": ["string", "null"], "maxLength": 80 },
        "effects_mode": { "enum": ["full", "reduced", "static"] },
        "save_resume_used": { "type": "boolean" },
        "guide_mode": { "enum": ["full", "express"] },
        "guide_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "question_graph_version": { "type": "string", "maxLength": 120 },
        "guide_session_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "recommendation_reason_codes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$" }
        },
        "unresolved_items": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$" }
        },
        "requested_counterfactuals": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["quieter", "smaller", "lower_cost", "upgrade_room", "performance_headroom"] }
        },
        "guide_requirements_projection": { "$ref": "#/$defs/guideRequirementsProjection" }
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "string", "maxLength": 10000 },
        { "type": "number" },
        { "type": "integer" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "maxItems": 100, "items": { "type": ["string", "number", "integer", "boolean", "null"] } },
        { "type": "object", "maxProperties": 50, "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] } }
      ]
    },
    "guideRequirementsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "source", "workload_profile", "operational_lane", "workload_refs",
        "budget", "cooling_mode", "allowed_motherboard_form_factors", "fresh_offer_required",
        "unknown_policy", "required_parts", "excluded_parts", "priorities", "inference",
        "unresolved", "operator_notes", "requested_counterfactuals", "projection_hash"
      ],
      "properties": {
        "schema_version": { "const": "forge-requirements/1" },
        "source": { "const": "forge-guide-session/1" },
        "workload_profile": { "type": ["string", "null"], "maxLength": 80 },
        "operational_lane": { "type": ["string", "null"], "maxLength": 80 },
        "workload_refs": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
        "budget": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["currency", "parts_ceiling_minor"],
          "properties": {
            "currency": { "const": "USD" },
            "parts_ceiling_minor": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          }
        },
        "cooling_mode": { "enum": ["any", "air", "aio", "custom_loop"] },
        "allowed_motherboard_form_factors": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 40 } },
        "fresh_offer_required": { "type": "boolean" },
        "unknown_policy": { "const": "review" },
        "required_parts": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } },
        "excluded_parts": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } },
        "priorities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workload_fit", "cost", "power_headroom", "evidence", "serviceability", "compactness", "upgradeability", "acoustics"],
          "properties": {
            "workload_fit": { "type": "integer", "minimum": 0, "maximum": 5 },
            "cost": { "type": "integer", "minimum": 0, "maximum": 5 },
            "power_headroom": { "type": "integer", "minimum": 0, "maximum": 5 },
            "evidence": { "type": "integer", "minimum": 0, "maximum": 5 },
            "serviceability": { "type": "integer", "minimum": 0, "maximum": 5 },
            "compactness": { "type": "integer", "minimum": 0, "maximum": 5 },
            "upgradeability": { "type": "integer", "minimum": 0, "maximum": 5 },
            "acoustics": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        "inference": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason_code", "confidence_basis_points"],
            "properties": {
              "field": { "type": "string", "maxLength": 120 },
              "reason_code": { "type": "string", "maxLength": 120 },
              "confidence_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason_code"],
            "properties": {
              "field": { "type": "string", "maxLength": 120 },
              "reason_code": { "enum": ["visitor_skipped", "requires_clarification"] }
            }
          }
        },
        "operator_notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 400 } },
        "requested_counterfactuals": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["quieter", "smaller", "lower_cost", "upgrade_room", "performance_headroom"] }
        },
        "projection_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "value", "answered_at", "source", "data_classification"],
      "properties": {
        "question_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$" },
        "value": { "$ref": "#/$defs/jsonValue" },
        "display_value": { "type": ["string", "null"], "maxLength": 10000 },
        "answered_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["client", "prefill", "operator_correction"] },
        "data_classification": { "enum": ["public", "client_confidential", "restricted"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "original_filename", "declared_mime", "size_bytes", "custody_state", "data_classification"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^art_[A-Za-z0-9_-]{12,64}$" },
        "original_filename": { "type": "string", "maxLength": 255 },
        "declared_mime": { "type": "string", "maxLength": 120 },
        "detected_mime": { "type": ["string", "null"], "maxLength": 120 },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "custody_state": { "enum": ["uploading", "quarantined", "scan_passed", "scan_failed", "rejected", "preserved"] },
        "data_classification": { "enum": ["public", "client_confidential", "restricted"] },
        "purpose_question_id": { "type": ["string", "null"] }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_id", "notice_version", "granted", "recorded_at"],
      "properties": {
        "consent_id": { "enum": ["process_intake", "automated_classification", "save_resume", "marketing"] },
        "notice_version": { "type": "string", "maxLength": 40 },
        "granted": { "type": "boolean" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
