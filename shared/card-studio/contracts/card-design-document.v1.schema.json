{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/card-studio/card-design-document.v1.schema.json",
  "title": "Hyperion Card Studio design document",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_id", "project_id", "revision", "template_id", "product_sku", "artboards", "profile", "asset_refs", "preflight", "updated_at"],
  "properties": {
    "contract_version": { "const": "card-design-document/1" },
    "document_id": { "type": "string", "pattern": "^cdd_[A-Za-z0-9_-]{12,64}$" },
    "project_id": { "type": "string", "pattern": "^csp_[A-Za-z0-9_-]{12,64}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "template_id": { "type": "string", "pattern": "^(template_[a-z0-9_-]{2,48}|blank_guarded)$" },
    "product_sku": { "type": "string", "pattern": "^card_[a-z0-9_]{3,48}$" },
    "artboards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side", "background", "elements"],
        "properties": {
          "side": { "enum": ["front", "back"] },
          "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "elements": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "x", "y", "width", "height", "locked"],
              "properties": {
                "id": { "type": "string", "pattern": "^el_[A-Za-z0-9_-]{4,64}$" },
                "kind": { "enum": ["text", "shape", "asset", "qr", "nfc_mark"] },
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "locked": { "type": "boolean" },
                "text": { "type": "string", "maxLength": 240 },
                "font_token": { "type": "string", "pattern": "^[a-z0-9_-]{1,48}$" },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "asset_ref": { "type": "string", "pattern": "^csa_[A-Za-z0-9_-]{12,64}$" },
                "destination_ref": { "type": "string", "pattern": "^dst_[A-Za-z0-9_-]{8,64}$" }
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "headline", "visibility", "links"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "headline": { "type": "string", "maxLength": 160 },
        "visibility": { "enum": ["private", "unlisted", "public"] },
        "links": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "url": { "type": "string", "format": "uri", "maxLength": 2048 }
            }
          }
        }
      }
    },
    "asset_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^csa_[A-Za-z0-9_-]{12,64}$" }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "warnings", "renderer_version"],
      "properties": {
        "state": { "enum": ["not_run", "passed", "warnings", "failed"] },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]{2,80}$" }
        },
        "renderer_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$" }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
