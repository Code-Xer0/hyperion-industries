{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/card-studio/card-order-intent.v1.schema.json",
  "title": "Hyperion Card Studio order intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "intent_id", "project_id", "revision_id", "product_sku", "quantity", "proof_approved", "proof_refs", "consent"],
  "properties": {
    "contract_version": { "const": "card-order-intent/1" },
    "intent_id": { "type": "string", "pattern": "^coi_[A-Za-z0-9_-]{12,64}$" },
    "project_id": { "type": "string", "pattern": "^csp_[A-Za-z0-9_-]{12,64}$" },
    "revision_id": { "type": "string", "pattern": "^csr_[A-Za-z0-9_-]{12,64}$" },
    "product_sku": { "type": "string", "pattern": "^card_[a-z0-9_]{3,48}$" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "proof_approved": { "type": "boolean" },
    "proof_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^proof_[A-Za-z0-9_-]{8,80}$" }
    },
    "contact_ref": { "type": "string", "pattern": "^acct_[A-Za-z0-9_-]{8,80}$" },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms_version", "privacy_version", "approved_at"],
      "properties": {
        "terms_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "privacy_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
