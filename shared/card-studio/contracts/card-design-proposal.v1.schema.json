{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/card-studio/card-design-proposal.v1.schema.json",
  "title": "Hyperion Card Studio design proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "proposal_id", "intent_id", "project_id", "revision_id", "revision_hash", "catalog_version", "product_sku", "quantity", "eligibility", "estimate", "warnings", "proof_refs", "authority", "created_at"],
  "properties": {
    "contract_version": { "const": "card-design-proposal/1" },
    "proposal_id": { "type": "string", "pattern": "^cdp_[A-Za-z0-9_-]{12,64}$" },
    "intent_id": { "type": "string", "pattern": "^coi_[A-Za-z0-9_-]{12,64}$" },
    "project_id": { "type": "string", "pattern": "^csp_[A-Za-z0-9_-]{12,64}$" },
    "revision_id": { "type": "string", "pattern": "^csr_[A-Za-z0-9_-]{12,64}$" },
    "revision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "catalog_version": { "type": "string", "pattern": "^card-catalog\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "product_sku": { "type": "string", "pattern": "^card_[a-z0-9_]{3,48}$" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "eligibility": { "enum": ["instant_checkout_eligible", "review_required"] },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "unit_amount", "subtotal_amount", "binding"],
      "properties": {
        "currency": { "const": "USD" },
        "unit_amount": { "type": ["integer", "null"], "minimum": 0 },
        "subtotal_amount": { "type": ["integer", "null"], "minimum": 0 },
        "binding": { "const": false }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z0-9_.-]{2,80}$" }
    },
    "proof_refs": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^proof_[A-Za-z0-9_-]{8,80}$" }
    },
    "authority": { "const": "operator_review_only" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
