{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/digital-products/v1/generation-manifest.schema.json",
  "title": "Hyperion digital product generation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "generation_id", "product_id", "product_version", "compiler_version", "price_minor", "currency", "buyer", "configuration_sha256", "artifacts"],
  "properties": {
    "contract_version": { "const": "hyperion.digital-product-manifest/1" },
    "generation_id": { "type": "string", "pattern": "^gen_[A-Za-z0-9_-]{12,80}$" },
    "product_id": { "enum": ["agent-policy", "flight-pack", "routing-kit"] },
    "product_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "compiler_version": { "type": "string", "minLength": 1 },
    "price_minor": { "type": "integer", "minimum": 0 },
    "currency": { "const": "USD" },
    "buyer": { "type": "object", "additionalProperties": false, "required": ["name", "verifiedEmail", "licenseId"], "properties": { "name": { "type": "string", "minLength": 1 }, "verifiedEmail": { "type": "string", "format": "email" }, "licenseId": { "type": "string", "minLength": 8 } } },
    "configuration_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_length"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "byte_length": { "type": "integer", "minimum": 1 } } } }
  }
}
