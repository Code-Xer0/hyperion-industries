{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/site-builder/v1/schemas/block.schema.json",
  "title": "Hyperion Site Block",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "variant", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^blk_[a-z0-9][a-z0-9-]{2,63}$" },
    "type": {
      "type": "string",
      "enum": ["hero", "rich_text", "media", "media_strip", "card_grid", "cta_group", "stats", "timeline", "faq", "quote", "gallery", "divider"]
    },
    "version": { "const": 1 },
    "variant": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
    "data": { "type": "object" },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": { "type": "boolean" },
        "tablet": { "type": "boolean" },
        "mobile": { "type": "boolean" }
      }
    }
  }
}
