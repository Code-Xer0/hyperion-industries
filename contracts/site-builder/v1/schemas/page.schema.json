{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperion-industries.dev/contracts/site-builder/v1/schemas/page.schema.json",
  "title": "Hyperion Site Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "path", "template", "title", "description", "maturity", "indexable", "theme_ref", "blocks"],
  "properties": {
    "schema_version": { "const": "hyperion-page/1" },
    "id": { "type": "string", "pattern": "^page_[a-z0-9][a-z0-9-]{2,63}$" },
    "path": { "type": "string", "pattern": "^/[a-z0-9][a-z0-9/-]{0,95}$" },
    "template": { "enum": ["standard", "landing", "collection"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120, "x-publish-risk": "governed" },
    "description": { "type": "string", "minLength": 1, "maxLength": 320, "x-publish-risk": "governed" },
    "summary": { "type": "string", "maxLength": 500, "x-publish-risk": "low" },
    "maturity": { "type": "string", "minLength": 1, "maxLength": 96, "x-publish-risk": "governed" },
    "indexable": { "type": "boolean", "x-publish-risk": "governed" },
    "theme_ref": { "type": "string", "pattern": "^theme_[a-z0-9-]{3,48}$", "x-publish-risk": "governed" },
    "og_asset": { "type": ["string", "null"], "pattern": "^/assets/", "x-publish-risk": "governed" },
    "related_paths": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^/" },
      "x-publish-risk": "governed"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "block.schema.json" },
      "x-publish-risk": "governed"
    }
  }
}
