{
  "name": "hyperion-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-artifacts.mjs && node scripts/compile-legacy-public.mjs",
    "lint": "eslint .",
    "public:compiled-check": "node scripts/verify-public-artifacts.mjs",
    "seo:generate": "node scripts/generate-seo-artifacts.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "seo:edge-test": "node --test workers/site-edge/test/routing.test.mjs",
    "mcp:check": "npm run check --prefix workers/public-mcp",
    "operator:check": "npm run check --prefix workers/operator",
    "check": "npm run lint && npm run build && npm run public:compiled-check && npm run seo:verify && npm run seo:edge-test && npm run operator:check && npm run mcp:check",
    "substrate:audit": "node scripts/audit-portal.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@upstash/redis": "^1.34.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
