# ── Hyperion Radio telemetry (production / Vercel) ──
# Provision a KV store: Vercel dashboard → Storage → KV (Upstash Redis).
# Linking it to the project injects these two automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret that gates the /api/stats dashboard endpoint. Set any random string,
# then view the dashboard at /radio-stats?token=THE_SAME_VALUE
STATS_TOKEN=

# ── Hyperion commerce/order intake (server-only) ──
# Public site remains inquiry-led. These values are only for the staged
# operator-reviewed Shopify draft-order lane.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-04
ORDER_ADMIN_TOKEN=

# Hyperion Operator resident. The resident defaults on. Public model chat stays
# off until the Cloudflare Worker route, D1 binding, and email binding are live.
VITE_OPERATOR_RESIDENT_ENABLED=true
VITE_OPERATOR_CHAT_ENABLED=false
VITE_OPERATOR_API_BASE=/api/operator
